<?xml version="1.0" encoding="utf-8"?>
<!-- 标题 + 通栏大图的新闻 (头条/专题大图模式) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_qingchuan_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:padding="@dimen/page_padding">

    <TextView
        android:id="@+id/tv_title_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_title"
        android:textColor="@color/text_primary"
        android:lineSpacingMultiplier="1.15"/>

    <ImageView
        android:id="@+id/iv_big"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:layout_marginTop="@dimen/space_m"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_shop_card"
        android:contentDescription="新闻大图"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_source_big"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"/>

        <TextView
            android:id="@+id/tv_time_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:maxLines="1"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"/>
    </LinearLayout>
</LinearLayout>
