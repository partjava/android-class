<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp">

    <!-- 用户圆形头像 -->
    <ImageView
        android:id="@+id/iv_comment_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/avatar_blue"
        android:contentDescription="用户头像"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- 用户名与院系标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_comment_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴川学子"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_comment_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="认证校友"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- 评论点赞按钮 -->
            <LinearLayout
                android:id="@+id/ll_comment_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_comment_like"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_like"
                    app:tint="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/tv_comment_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 评论正文 -->
        <TextView
            android:id="@+id/tv_comment_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="评论内容"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"/>

        <!-- 评论时间 -->
        <TextView
            android:id="@+id/tv_comment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="刚刚"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>
