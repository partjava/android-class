<?xml version="1.0" encoding="utf-8"?>
<!--
    视频页，从上到下四段：

    1. 红色顶栏：标题 + 搜索入口。这里没有返回键——它是底部导航的 tab 页，
       和首页/商城/我的同级，不是二级页
    2. 频道标签：一排 tab（推荐/小视频/影视/音乐），选中带红下划线，
       由 VideoActivity 动态 inflate item_channel_tab 塞进去
    3. 视频列表：单列大封面卡片流
    4. 底部导航
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- 顶栏：品牌红底 + 标题 + 搜索入口，和商城页同款 -->
    <LinearLayout
        android:id="@+id/top_bar"
        style="@style/Widget.Toutiao.TopBar"
        android:paddingHorizontal="@dimen/page_padding"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Widget.Toutiao.TopBarTitle"
            android:text="视频"/>

        <TextView
            android:id="@+id/tv_search_hint"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_l"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/space_s"
            android:text="搜索你感兴趣的视频"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_body_small"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hs_video_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:id="@+id/ll_video_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs"/>
    </HorizontalScrollView>

    <!-- 高度 0dp，上下都约束住，中间这一段自己滚 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_video"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_page"
        android:paddingTop="@dimen/space_s"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/hs_video_tabs"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"/>

    <!-- 底部导航栏，固定在屏幕底部，不会跟着列表滚。

         ⚠️ style 不能省。五个菜单项不是写在这里的，而是挂在
         Widget.Toutiao.BottomNav 这个 style 里的（app:menu）。
         漏掉 style 的结果是整条导航栏一个图标都没有，而且
         VideoActivity 里 setSelectedItemId / setOnItemSelectedListener
         全部静默失效——商城页之前就是这么坏的，这里一次写全。 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.Toutiao.BottomNav"
        android:fitsSystemWindows="true"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
