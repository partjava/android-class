<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部导航栏 -->
    <LinearLayout style="@style/Widget.Toutiao.TopBar">
        <ImageView
            android:id="@+id/iv_library_back"
            style="@style/Widget.Toutiao.NavIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"/>

        <TextView
            android:id="@+id/tv_library_title"
            style="@style/Widget.Toutiao.TopBarTitle"
            android:text="内容中心"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_library_compose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 发布"
            android:textColor="@color/on_brand"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- 分类切换标签栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:gravity="center">

        <TextView
            android:id="@+id/tab_lib_posts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我的作品"
            android:textSize="15sp"
            android:textColor="@color/brand_red"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_lib_saved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我的收藏"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tab_lib_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="浏览历史"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- 内容列表与空状态 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_library_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"/>

        <!-- 空状态提示 -->
        <LinearLayout
            android:id="@+id/ll_library_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_book"
                android:tint="@color/text_hint"
                android:contentDescription="空内容"/>

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="还没有发布过作品，快点击右上角发布吧！"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
