<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_red"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_m">

            <TextView
                android:id="@+id/tv_home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仿今日头条"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_m"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="@color/text_hint"
                android:drawablePadding="@dimen/space_s"
                android:hint="搜你想搜的"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="@dimen/space_m"
                android:textSize="@dimen/text_body_small"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_surface">

            <HorizontalScrollView
                android:id="@+id/hsv_tab_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_s"
                    android:paddingEnd="@dimen/space_s"/>
            </HorizontalScrollView>

            <!-- 右侧频道管理入口 (汉堡菜单图标) -->
            <FrameLayout
                android:id="@+id/btn_channel_manage"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@color/bg_surface"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_channels"
                    app:tint="@color/text_primary"
                    android:contentDescription="频道管理"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_campus_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar">

        <TextView
            android:id="@+id/tv_campus_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏫 武汉晴川学院官网 · 点击右侧立即爬取刷新"
            android:textColor="#E65100"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btn_campus_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_publish"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="🕷️ 爬取刷新"
            android:textColor="@color/on_brand"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_news"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_page"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@id/ll_campus_banner"
        app:layout_constraintBottom_toTopOf="@id/ll_campus_footer"/>

    <ListView
        android:id="@+id/lv_craft"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_page"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_campus_banner"
        app:layout_constraintBottom_toTopOf="@id/ll_campus_footer"/>

    <ProgressBar
        android:id="@+id/pb_school_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"/>

    <WebView
        android:id="@+id/wv_school_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pb_school_loading"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:text="没有找到相关内容，试试其他关键词"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_campus_banner"/>

    <!-- 触底无限流自动加载状态条：展示加载动画或已动态接上去的数量 -->
    <LinearLayout
        android:id="@+id/ll_campus_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFA"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="9dp"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:id="@+id/pb_campus_loading"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_campus_footer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 下滑触底自动加载更多要闻..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
