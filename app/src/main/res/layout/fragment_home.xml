<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_red"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仿今日头条"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_m"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawableTint="@color/text_hint"
                android:drawablePadding="@dimen/space_s"
                android:hint="搜你想搜的"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingHorizontal="@dimen/space_m"
                android:textSize="@dimen/text_body_small"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_tab_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_s">

                <TextView
                    android:id="@+id/tab_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="推荐"
                    android:textColor="@color/brand_red"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_kangyi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="健康"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_video_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小视频"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_beijing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="北京"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_hot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="热点"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
                <TextView
                    android:id="@+id/tab_entertain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="娱乐"
                    android:textColor="@color/tab_inactive"
                    android:textSize="@dimen/text_title"
                    android:paddingHorizontal="@dimen/space_m"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_news"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_page"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ListView
        android:id="@+id/lv_craft"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg_page"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        app:layout_constraintBottom_toBottomOf="parent"/>

<TextView android:id="@+id/tv_search_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="32dp" android:gravity="center" android:text="没有找到相关内容，试试其他关键词" android:textColor="@color/text_secondary" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/ll_top_bar" />
</androidx.constraintlayout.widget.ConstraintLayout>
