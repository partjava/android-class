<?xml version="1.0" encoding="utf-8"?>
<!-- ECharts 天气曲线页：顶栏 + WebView（加载 assets/echarts/weather.html） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101418"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="#1C2430">
        <ImageView android:id="@+id/iv_weather_back" android:layout_width="60dp" android:layout_height="match_parent"
            android:padding="14dp" android:src="@drawable/ic_back" android:contentDescription="返回"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="天气曲线 · ECharts" android:textSize="18sp" android:textStyle="bold" android:textColor="#E8EEF4"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="16dp" android:text="混合开发演示" android:textSize="12sp" android:textColor="#8A97A3"/>
    </LinearLayout>

    <WebView android:id="@+id/weather_web" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
