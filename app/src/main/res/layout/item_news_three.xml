<?xml version="1.0" encoding="utf-8"?>
<!-- 标题 + 三张并排小图的新闻 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:layout_marginBottom="@dimen/space_s"
    android:padding="@dimen/page_padding">

    <TextView
        android:id="@+id/tv_title_three"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_title"
        android:textColor="@color/text_primary"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_three1"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:contentDescription="新闻配图"/>
        <ImageView
            android:id="@+id/iv_three2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:scaleType="centerCrop"
            android:contentDescription="新闻配图"/>
        <ImageView
            android:id="@+id/iv_three3"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:scaleType="centerCrop"
            android:contentDescription="新闻配图"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_source_three"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"/>
        <TextView
            android:id="@+id/tv_time_three"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:maxLines="1"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"/>
    </LinearLayout>
</LinearLayout>
