<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <LinearLayout
        android:id="@+id/top_bar"
        style="@style/Widget.Toutiao.TopBar"
        android:paddingHorizontal="@dimen/page_padding"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Widget.Toutiao.TopBarTitle"
            android:text="商城"/>

        <TextView
            android:id="@+id/tv_search_hint"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_l"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_l"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/space_s"
            android:text="搜索你想找的商品"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/text_body_small"/>

        <ImageView
            android:id="@+id/btn_cart"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_s"
            android:padding="6dp"
            android:src="@drawable/ic_shop"
            app:tint="@color/on_brand" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hs_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:id="@+id/ll_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs"/>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_shop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="@color/bg_page"
        app:layout_constraintTop_toBottomOf="@id/hs_tabs"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_surface">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"/>

                <LinearLayout
                    android:id="@+id/ll_dots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/space_m">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_active"/>

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="@drawable/bg_dot_inactive"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_shop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
