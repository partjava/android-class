<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <!-- 顶部红色导览导航栏 -->
    <LinearLayout
        android:id="@+id/ll_guide_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_red"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_guide_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white"
            android:visibility="gone"
            android:contentDescription="返回"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ 晴川三维全景导览"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="双指缩放 · 拖拽漫游 · 点击任意建筑探索"
                android:textColor="#E0F2FE"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- 切换对比图 -->
        <TextView
            android:id="@+id/btn_switch_marked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="🏷️ 层数对照"
            android:textColor="@color/brand_red"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 分类筛选横条 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1E293B"
        android:paddingVertical="6dp"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/ll_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:text="🌈 全部 (18)"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chip_teaching"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:text="🎓 教学综合 (7)"
                android:textColor="#CBD5E1"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/chip_lab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:text="🔬 实验科创 (4)"
                android:textColor="#CBD5E1"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/chip_culture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:text="📚 文体研学 (4)"
                android:textColor="#CBD5E1"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/chip_living"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="🍱 生活宿区 (3)"
                android:textColor="#CBD5E1"
                android:textSize="11sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 地图核心视口与悬浮控制面板 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 自定义交互地图 -->
        <com.example.toutiao.demo.Campus3DMapView
            android:id="@+id/campus_map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 左下角操作微提示 -->
        <TextView
            android:id="@+id/tv_gesture_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="#CC0F172A"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="👆 单指拖动 · 双指缩放 · 点击建筑"
            android:textColor="#94A3B8"
            android:textSize="10sp"/>

        <!-- 右侧悬浮控制按钮组 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:elevation="6dp">

            <TextView
                android:id="@+id/btn_map_zoom_in"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shop_card"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:elevation="4dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/btn_map_zoom_out"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shop_card"
                android:gravity="center"
                android:text="－"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:elevation="4dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/btn_map_reset"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shop_card"
                android:gravity="center"
                android:text="🧭"
                android:textSize="16sp"
                android:elevation="4dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部建筑水平快速跳转卡片栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📌 校园地标速查"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_landmark_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18处地标已标定"
                android:textColor="@color/text_hint"
                android:textSize="11sp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quick_landmarks"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:clipToPadding="false"/>
    </LinearLayout>

</LinearLayout>
