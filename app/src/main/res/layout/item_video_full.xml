<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_player">

    <ImageView
        android:id="@+id/iv_full_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="视频封面"/>
<com.example.toutiao.demo.OfflinePlayer android:id="@+id/player_full" android:layout_width="match_parent" android:layout_height="match_parent" />

    
    <View
        android:id="@+id/v_full_scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"/>

    
    <ImageView
        android:id="@+id/iv_full_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_play_circle"
        android:contentDescription="播放"/>

    
    <FrameLayout
        android:id="@+id/fl_full_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:background="@color/progress_track">

        <View
            android:id="@+id/v_full_progress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/brand_red"/>
    </FrameLayout>

    
    <LinearLayout
        android:id="@+id/ll_full_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="64dp"
        android:paddingBottom="@dimen/space_m">

        <TextView
            android:id="@+id/tv_full_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_on_dark"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_full_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_on_dark_secondary"
                android:textSize="@dimen/text_body_small"/>

            
            <TextView
                android:id="@+id/tv_full_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:background="@drawable/bg_video_duration"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingVertical="@dimen/space_xs"
                android:maxLines="1"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_caption"/>

            
            <TextView
                android:id="@+id/tv_full_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_caption"/>
        </LinearLayout>
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/ll_full_rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="@dimen/space_l">

        
        <FrameLayout
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target">

            <TextView
                android:id="@+id/tv_full_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_circle_scrim_ripple"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/on_brand"
                android:textSize="@dimen/text_body"/>

            
            <ImageView
                android:id="@+id/iv_full_follow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_circle_brand"
                android:padding="3dp"
                android:src="@drawable/ic_add"
                android:contentDescription="关注"/>
        </FrameLayout>

        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_full_like"
                style="@style/Widget.Toutiao.NavIcon"
                android:background="@drawable/bg_circle_scrim_ripple"
                android:src="@drawable/ic_like"
                android:contentDescription="点赞"/>

            <TextView
                android:id="@+id/tv_full_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="1"
                android:textColor="@color/text_on_dark"
                android:textSize="@dimen/text_caption"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_full_comment"
                style="@style/Widget.Toutiao.NavIcon"
                android:background="@drawable/bg_circle_scrim_ripple"
                android:src="@drawable/ic_msg"
                android:contentDescription="评论"/>

            <TextView
                android:id="@+id/tv_full_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="1"
                android:textColor="@color/text_on_dark"
                android:textSize="@dimen/text_caption"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_full_collect"
            style="@style/Widget.Toutiao.NavIcon"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_circle_scrim_ripple"
            android:src="@drawable/ic_collect"
            android:contentDescription="收藏"/>

        <ImageView
            android:id="@+id/iv_full_share"
            style="@style/Widget.Toutiao.NavIcon"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_circle_scrim_ripple"
            android:src="@drawable/ic_share"
            android:contentDescription="分享"/>
    </LinearLayout>

    
    <ImageView
        android:id="@+id/iv_full_like_burst"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_like"
        android:tint="@color/brand_red"
        android:contentDescription="@null"/>
</FrameLayout>
