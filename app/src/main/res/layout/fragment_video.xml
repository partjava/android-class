<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_channels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <View
        android:id="@+id/v_feed_scrim"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:alpha="0"/>

    <LinearLayout
        android:id="@+id/ll_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            style="@style/Widget.Toutiao.TopBar"
            android:paddingHorizontal="@dimen/page_padding">

            <TextView
                android:id="@+id/tv_title"
                style="@style/Widget.Toutiao.TopBarTitle"
                android:text="视频"/>

            <TextView
                android:id="@+id/tv_search_hint"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_l"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_l"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/space_s"
                android:text="搜索你感兴趣的视频"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_body_small"/>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/hs_video_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/bg_surface">

            <LinearLayout
                android:id="@+id/ll_video_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_xs"/>
        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
