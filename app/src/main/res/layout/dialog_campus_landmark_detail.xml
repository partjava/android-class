<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_rounded"
    android:paddingBottom="24dp">

    <!-- 顶部拖拽手柄条 -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#D1D5DB"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 建筑高清实景卡片 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_shop_card"
                android:elevation="3dp">

                <ImageView
                    android:id="@+id/iv_landmark_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/user_crop_library"
                    android:contentDescription="建筑实景图"/>

                <!-- 右上角切换标记对比原图 -->
                <TextView
                    android:id="@+id/btn_toggle_marked_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_btn_publish"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="🏷️ 查看层数标记图"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:elevation="4dp"/>

                <!-- 左下角楼层胶囊徽章 -->
                <TextView
                    android:id="@+id/tv_landmark_floor_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🏢 共5层"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:elevation="4dp"/>
            </FrameLayout>

            <!-- 标题栏与分类 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="教学楼1栋（基础教学大楼）"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_detail_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="智慧多媒体"
                    android:textColor="@color/brand_red"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 概述 -->
            <TextView
                android:id="@+id/tv_detail_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:text="学校核心本科教学大楼之一，配备高流明多媒体投影、双师智慧黑板与静音空调系统。"/>

            <!-- 楼层分布详情板块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:background="#F8FAFC"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 楼层结构与科室分布指南"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_detail_floors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="1F：阶梯大教室\n2F：标准多媒体教室\n3F：专业基础课教室"/>
            </LinearLayout>

            <!-- 开放时间与服务电话 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv_detail_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:text="⏰ 开放时间：每日 07:30 - 21:30"/>

                <TextView
                    android:id="@+id/tv_detail_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:text="📞 服务电话：027-87934455"/>

                <TextView
                    android:id="@+id/tv_detail_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#D97706"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:text="💡 导学贴士：每层洗手间旁均设有冷热直饮水机。"/>
            </LinearLayout>

            <!-- 关闭/我知道了按钮 -->
            <TextView
                android:id="@+id/btn_detail_ok"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_publish"
                android:gravity="center"
                android:text="我知道了"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
