<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <!-- 顶部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:background="@color/bg_surface">

        <ImageView
            android:id="@+id/iv_publish_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="取消"/>

        <!-- 模式切换标签 -->
        <LinearLayout
            android:id="@+id/ll_mode_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mode_micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发微头条"
                android:textSize="16sp"
                android:textColor="@color/brand_red"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tv_mode_article"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="写文章"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tv_mode_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发视频"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 发布胶囊按钮 -->
        <Button
            android:id="@+id/btn_publish_submit"
            android:layout_width="68dp"
            android:layout_height="34dp"
            android:text="发布"
            android:textSize="14sp"
            android:textColor="@color/on_brand"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_publish"
            android:gravity="center"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- 中间滚动编辑区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 标题输入栏（写文章/发视频模式默认展开） -->
            <EditText
                android:id="@+id/et_publish_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="填写标题会有更多推荐（5-30字）..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@null"
                android:paddingVertical="8dp"
                android:maxLines="2"
                android:visibility="gone"/>

            <View
                android:id="@+id/v_title_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginVertical="6dp"
                android:visibility="gone"/>

            <!-- 正文多行输入框 -->
            <EditText
                android:id="@+id/et_publish_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="6"
                android:gravity="top|start"
                android:hint="分享你的新鲜事、专业见解或生活日常..."
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:background="@null"
                android:lineSpacingExtra="4dp"
                android:paddingVertical="8dp"/>

            <!-- 字数统计 -->
            <TextView
                android:id="@+id/tv_word_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 / 1000"
                android:textSize="12sp"
                android:textColor="@color/text_hint"
                android:gravity="end"
                android:layout_marginTop="4dp"/>

            <!-- 图片配图预览区域 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_photo_previews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 添加配图卡片 -->
                    <LinearLayout
                        android:id="@+id/ll_add_photo_slot"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_search"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_photo"
                            android:tint="@color/text_tertiary"
                            android:contentDescription="添加配图"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+ 配图"
                            android:textSize="12sp"
                            android:textColor="@color/text_tertiary"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 热门话题推荐 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="添加热门话题："
                android:textSize="13sp"
                android:textColor="@color/text_tertiary"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_topic_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_topic_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#深中通道世界奇迹#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chip_topic_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#中国空间站科研突破#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chip_topic_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#科技数码前沿#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chip_topic_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#大国工匠的日常#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chip_topic_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#今天吃什么#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chip_topic_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#生活碎碎念#"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 附加元数据选项（定位与公开范围） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_publish_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 北京市·海淀区"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tv_publish_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 公开 · 所有人可见"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部快捷工具条 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:background="@color/bg_surface">

        <ImageView
            android:id="@+id/iv_tool_photo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_photo"
            android:tint="@color/text_secondary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="插入图片"/>

        <ImageView
            android:id="@+id/iv_tool_topic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_topic"
            android:tint="@color/text_secondary"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="插入话题"/>

        <ImageView
            android:id="@+id/iv_tool_location"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_location"
            android:tint="@color/text_secondary"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="选择定位"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_tool_draft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="存草稿"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
