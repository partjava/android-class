<?xml version="1.0" encoding="utf-8"?>
<!--
    商品详情「商品评价」卡里的一行评价。
    不走 RecyclerView：每页固定只展示 2 条，直接 inflate 进
    ll_review_rows 这个 LinearLayout（先例：VideoDetailActivity 的相关视频）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 彩底 + 昵称首字的圆形头像，颜色 Java 侧从 avatar_* 色板染色 -->
        <TextView
            android:id="@+id/tv_review_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_avatar_fill"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:textColor="@color/on_brand"/>

        <TextView
            android:id="@+id/tv_review_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_review_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_review_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textSize="@dimen/text_body_small"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp"/>
</LinearLayout>
