<resources>

    <!-- ================================================================
         深色模式下的主题

         ⚠️ 这个文件必须和 values/themes.xml 逐项一致。

         为什么：values-night 是按"设备是否处于深色模式"命中的，和主题
         parent 是不是 Light 无关。如果这里留空或写得不一样，深色设备上
         主题属性就会缺失，而**在浅色模式下完全测不出来**。

         本应用是一个强制浅色的应用（布局里全是硬编码浅色底 + 深色字），
         所以这里故意写和浅色模式相同的定义，让深色设备上表现完全一致。
         ================================================================ -->
    <style name="Theme.Toutiao" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/brand_red_dark</item>
        <item name="colorAccent">@color/brand_red</item>

        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSecondaryVariant">@color/brand_red_dark</item>
        <item name="colorOnSecondary">@color/on_brand</item>

        <item name="android:statusBarColor">@color/brand_red</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <item name="android:windowBackground">@color/bg_surface</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="switchStyle">@style/Widget.AppCompat.CompoundButton.Switch</item>
    </style>

</resources>
