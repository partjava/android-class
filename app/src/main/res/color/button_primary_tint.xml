<?xml version="1.0" encoding="utf-8"?>
<!--
    主按钮的着色状态表。

    为什么需要这个文件：Material 主题下 <Button> 会被换成的 MaterialButton
    只认 backgroundTint，不认 android:background。原来放在
    bg_button_primary.xml 里的三态（按压/禁用/常态）必须改从这里表达。

    顺序即优先级，第一条命中的生效：
      禁用 → 灰
      按压 → 深红（已装机实测：「去评论」按住时明显变深）
      常态 → 品牌红

    注：禁用态目前是备用分支。全项目 Java 里没有一处 setEnabled，
    按钮不会真的进入禁用状态，所以这一条现在不会命中；留着是为了
    以后加校验时不用再回来补。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/icon_arrow"/>
    <item android:state_pressed="true" android:color="@color/brand_red_dark"/>
    <item android:color="@color/brand_red"/>
</selector>
