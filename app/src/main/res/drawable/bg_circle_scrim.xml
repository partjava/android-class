<?xml version="1.0" encoding="utf-8"?>
<!-- 沉浸播放页左上角返回键的圆底（40dp，正好是 NavIcon 那个盒子的尺寸）。

     封面是铺满上半屏的，可能是浅色的（比如 image7 偏亮），
     白箭头直接压上去就看不见了。
     半透明黑圆 + 白箭头，和封面上的播放键（ic_play_circle）、
     右下角的时长角标（bg_video_duration）是同一套遮罩色（scrim_40）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/scrim_40"/>
</shape>
