<?xml version="1.0" encoding="utf-8"?>
<!--
    「客服中心」的图标。

    改造前它和 ic_refund.xml 都是"圆圈里一个感叹号"的变体
    （一个感叹号、一个倒过来的感叹号），在 48dp 下几乎分不出来 ——
    截图里「客服中心」和「退款/售后」就是两个一模一样的「(!)」。

    现在改成耳机（客服的标准图形），和退款那个彻底分开。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 头梁：外弧，两端向下收成两条竖边 -->
    <path
        android:fillColor="#333333"
        android:pathData="M12,3a8,8 0 0 0 -8,8v2h2v-2a6,6 0 0 1 12,0v2h2v-2a8,8 0 0 0 -8,-8z"/>
    <!-- 左右两个耳罩 -->
    <path
        android:fillColor="#333333"
        android:pathData="M4,12.5h3.2v8.2h-3.2z" />
    <path
        android:fillColor="#333333"
        android:pathData="M16.8,12.5h3.2v8.2h-3.2z" />
</vector>
