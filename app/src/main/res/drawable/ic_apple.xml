<?xml version="1.0" encoding="utf-8"?>
<!--
    「Apple 登录」的图标。

    改造前这里的 pathData 是一坨自相交的乱码（像是把位图描摹了一遍又拼错了），
    渲染出来是一个带白色窟窿的黑团，登录页上非常显眼。

    现在改用一条完整的轮廓路径画：
      果身 = 圆心 (12,13) 半径 8 的圆，从缺口上沿 (19.46,10.11) 逆时针绕一大圈
             到缺口下沿 (17.39,18.91)；
      缺口 = 圆心 (20.5,15) 半径 5 的圆，从下沿回到上沿，这一小段向里凹，
             正是被咬掉的那一口。
    两个点都是两圆的实际交点（都精确落在两个圆上，半径对得上）。

    注意不要用 evenOdd 拼两个圆来做咬痕：那样只有"重叠的透镜区"会被挖空，
    咬痕圆露在果身外面的那半个仍然会填色，最后画出来是个球上粘了个小球。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 果身 + 缺口，一笔画完 -->
    <path
        android:fillColor="#333333"
        android:pathData="M19.46,10.11A8,8 0 1 0 17.39,18.91A5,5 0 0 1 19.46,10.11Z"/>

    <!-- 叶子 -->
    <path
        android:fillColor="#333333"
        android:pathData="M12.2,5.4C12.6,2.6 14.6,1.0 17.2,1.0C17.0,3.8 15.0,5.5 12.2,5.4Z"/>
</vector>
