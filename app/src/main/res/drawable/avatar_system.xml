<?xml version="1.0" encoding="utf-8"?>
<!--
    系统类会话的头像：品牌红圆底 + 白色铃铛。

    说话的是平台而不是某个人，所以刻意和上面那组「彩色圆底 + 人形」区分开 —
    红底一出现就知道这条不是真人发来的。

    铃铛的 path 来自 ic_notify.xml（24 视口，实际占 x∈[4,20] y∈[2.5,22]），
    直接放进 r=10 的圆里会顶到边，所以用 group 缩到 0.6 倍，
    pivot 取铃铛自己的中心而不是画布中心（铃铛重心偏下，用 12,12 会歪）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@color/brand_red"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z"/>

    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:pivotX="12"
        android:pivotY="12.25">
        <path
            android:fillColor="@color/avatar_fg"
            android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.89,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z"/>
    </group>
</vector>
